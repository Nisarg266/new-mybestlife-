{
  "name": "t:sections.overlay.name",
  "type": "custom.overlay",
  "sections": {
    "cart-drawer": {
      "type": "cart-drawer",
      "settings": {
        "card_media_aspect_ratio": "3/4",
        "button_url": "shopify://collections/collection"
      }
    },
    "quick-cart-drawer": {
      "type": "quick-cart-drawer",
      "settings": {
        "color_scheme": ""
      }
    },
    "age-verification-popup": {
      "type": "age-verification-popup",
      "disabled": true,
      "settings": {
        "heading": "Verify your age",
        "heading_size": "h5",
        "text": "\u003cp\u003eYou must be 18 years of age or older to enter this site. Please verify your age.\u003c/p\u003e",
        "content_alignment": "center",
        "show_blurred_backdrop": false,
        "button_confirm": "Yes",
        "button_confirm_style": "button--filled",
        "button_decline": "No",
        "button_decline_url": "/",
        "button_decline_style": "button--text",
        "show_popup_on_customizer": false,
        "color_scheme": ""
      }
    },
    "newsletter-popup": {
      "type": "newsletter-popup",
      "disabled": true,
      "settings": {
        "delay": 10,
        "heading": "Newsletter heading here",
        "heading_size": "h3",
        "text": "\u003cp\u003eAn example subheading for new subscribers.\u003c/p\u003e",
        "button_close_text": "No thanks",
        "show_popup_on_customizer": false,
        "color_scheme": ""
      }
    }
  },
  "order": [
    "cart-drawer",
    "quick-cart-drawer",
    "age-verification-popup",
    "newsletter-popup"
  ]
}